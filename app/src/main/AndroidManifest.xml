<?xml version="1.0" encoding="utf-8"?>
<!-- Sin permisos: el MVP funciona sin conexión y no necesita acceso a Internet. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".FuncodeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FuncodeAcademy">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- PROTOTIPO Fase 8: compila y ejecuta programas de estudiantes en un proceso
             aislado (UID propio, sin permisos, sin acceso a los datos de la app).
             No exportado: solo esta app puede usarlo. -->
        <service
            android:name=".runner.JavaRunnerService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":javarunner" />
    </application>
</manifest>
