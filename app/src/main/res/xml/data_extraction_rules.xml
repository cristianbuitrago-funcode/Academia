<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: la copia de seguridad incluye solo la base de datos de progreso y los ajustes. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
